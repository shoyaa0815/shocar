# Set the board's actual IP address, then restart the server.
ROBOT_URL=http://192.168.1.50
# Set Wi-Fi credentials directly in robot/wifi.ino.

# IP Webcam address shown on the phone. Base addresses automatically use /video.
# Leave empty to run without a camera. Restart the server after changes.
CAMERA_URL=

# Cumulative motor-on seconds for approximately one full spin (excludes pauses).
# 4.0 is provisional: calibrate on the actual robot, then restart the server.
# Allowed range: 0.2–60 seconds. No heading sensor: this is not a measured 360 degrees.
AUTO_SPIN_SECONDS=4.0

# Dashboard distance panel only. These describe where the phone camera sits on
# the car; the centimetre numbers are an estimate from them, never a measurement,
# and are never used by automatic driving.
# Camera lens height above the floor in cm (allowed 5–200).
CAMERA_HEIGHT_CM=20
# Camera downward tilt from horizontal in degrees (allowed -45–89).
CAMERA_TILT_DEG=15
# Horizontal field of view of the phone camera in degrees (allowed 20–170).
CAMERA_HFOV_DEG=65
